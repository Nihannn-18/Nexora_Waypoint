# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.nx/migrate-runs
.claude/worktrees
.claude/settings.local.json

# Next.js
.next
out
# Environment — .env.example is committed, .env is not
.env
.env.local
.env.*.local

# Go
coverage.out
*.test
apps/api/waypoint-api
apps/api/waypoint-worker

# Competition datasets: large, and the booklet forbids redistributing them.
# Seed data derived for the demo day belongs in the repo; raw supplied CSVs do not.
/data/raw/
.neon

# Datathon Task 1 / Task 2A inputs are not part of the Hackathon contract
# (CLAUDE.md rule 10 / section 6 lists only the reference CSVs and the two
# Task 2B files). A teammate keeps the originals locally; they are not tracked.
docs/general-data/task1_test_inputs.csv
docs/general-data/task2a_test_inputs.csv

# Any remaining environment files are local-only. The committed template is
# .env.example, which the negation below keeps tracked.
.env.*
!.env.example

# TypeScript build info
*.tsbuildinfo

# Playwright E2E artifacts
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# --- Deployment / infrastructure -------------------------------------------
# Vercel link state (per-developer, never shared).
.vercel/
.vercel
.env.vercel

# Terraform: state, plans and variable files carry environment detail and, for
# variable files, potentially secrets. Only *.tfvars.example is committed.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform CLI config may hold credentials.
.terraformrc
terraform.rc

# AWS CLI credentials and config, if ever written into the workspace.
.aws/
credentials

# Local deployment scratch: rendered env files and SSM output never get
# committed. (The real production file lives on the instance, not here.)
infra/deploy/.env*
!infra/deploy/.env.example
.env*
