{
  "name": "@nexora-waypoint/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "description": "Waypoint Delivery Planning System — Nexora, Rootcode Tech-Triathlon 2026",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "nx dev web",
    "dev:api": "nx serve api",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "fmt": "prettier --write . && nx fmt api",
    "fmt:check": "prettier --check . && nx fmt-check api",
    "typecheck": "tsc -p libs/shared-types/tsconfig.lib.json --noEmit && tsc -p libs/api-client/tsconfig.lib.json --noEmit && tsc -p libs/ui/tsconfig.lib.json --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "graph": "nx graph",
    "up": "docker compose up --build",
    "down": "docker compose down",
    "reset": "docker compose down -v && docker compose up --build"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/jest": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/next": "^23.2.1",
    "@nx/react": "^23.2.1",
    "@nx/workspace": "23.2.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "babel-jest": "~30.3.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "nx": "23.2.1",
    "postcss": "^8.5.28",
    "prettier": "~3.6.2",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
