# Waypoint Delivery Planning System — environment template.
#
#   cp .env.example .env
#
# Every value below has a working default except BETTER_AUTH_SECRET, which
# compose refuses to start without. Committing this file is intentional; committing .env
# is not — it is in .gitignore.

# --- Application ------------------------------------------------------------
APP_ENV=production

# The business day is reckoned in this zone. The 16:00 order cutoff and every
# delivery window are wall-clock times here, so do not change it casually.
TZ=Asia/Colombo

# --- Demo clock -------------------------------------------------------------
# The seeded demo day (Fri 25 Sep -> Sat 26 Sep 2026) is in the past, so the
# judge walkthrough needs the API clock, not the wall clock. With DEMO_MODE=true
# the clock starts at DEMO_CLOCK_START (RFC 3339 with offset) and ticks from
# there; GET /api/v1/meta reports it. Set DEMO_MODE=false for real operation.
DEMO_MODE=true
DEMO_CLOCK_START=2026-09-25T15:40:00+05:30

# --- Ports (host side) ------------------------------------------------------
# Change these if something already occupies them on your machine.
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=waypoint
RABBITMQ_PASSWORD=waypoint

# --- Auth (Better Auth) -----------------------------------------------------
# Better Auth runs in the Next.js app and owns accounts, passwords and sessions.
# The Go API only verifies the session; it holds no signing secret.
#
# REQUIRED. Compose refuses to start without it. Generate one:
#   openssl rand -base64 32
# The value below is a LOCAL-ONLY placeholder. Better Auth rejects placeholder
# secrets in production, so replace it before deploying.
BETTER_AUTH_SECRET=local-dev-only-change-me-before-deploying-000000

# The origin Better Auth signs in against (the web app's public URL).
BETTER_AUTH_URL=http://localhost:3000

# Origins allowed to start an auth flow (CSRF/redirect allow-list), comma
# separated. Include the deployed web origin when hosting.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# The password given to the four seeded demo accounts (see README). Demo-only;
# set a different value before any production-like deployment with real data.
DEMO_SEED_PASSWORD=waypoint2026

# The web app reads DATABASE_URL at runtime to reach the same database as the
# Go API. Compose derives it from the POSTGRES_* values above; set it explicitly
# for local `nx dev web`:
# DATABASE_URL=postgres://waypoint:waypoint@localhost:5432/waypoint?sslmode=disable

# --- Cross-origin -----------------------------------------------------------
# The web origin allowed to call the API. Must match where the web app is served.
CORS_ORIGIN=http://localhost:3000

# --- Web → API --------------------------------------------------------------
# The URL the JUDGE'S BROWSER uses to reach the API. It must be reachable from
# outside Docker, so it is the published host port — never http://api:8080,
# which only resolves on the compose network.
#
# This value is compiled into the client bundle at image build time. After
# changing it, rebuild:  docker compose up --build web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# ============================================================================
# LOCAL DEVELOPMENT / FALLBACK  (Docker Compose)
# ============================================================================
# The defaults above are the local path: Postgres and RabbitMQ run as compose
# services, and media is stored on the local filesystem. Nothing here needs AWS
# credentials, and `cp .env.example .env && docker compose up --build` works
# as-is.

# --- Media storage (local) --------------------------------------------------
# "local" writes uploads under MEDIA_ROOT inside the api container. Compose
# mounts a named volume there, so uploads survive `docker compose down` but are
# erased by `docker compose down -v` (a deliberate full reset).
MEDIA_STORAGE=local
MEDIA_ROOT=/data/media

# ============================================================================
# AWS / PRODUCTION  (hosted deployment — optional)
# ============================================================================
# AWS is the hosted deployment target, NOT a requirement: the Compose stack
# above runs entirely without it. These values are consumed only when
# MEDIA_STORAGE=s3. Do not commit real credentials — supply AWS access via an
# EC2 instance role or SSO, never here.

# S3_BUCKET=waypoint-media
# AWS_REGION=ap-southeast-1
