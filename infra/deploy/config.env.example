# Template for /opt/waypoint/config.env on the instance.
#
# This file holds NON-SECRET interpolation values for Docker Compose only.
# Terraform renders the real file at first boot (infra/terraform/locals.tf); it
# is reproduced here so the shape is reviewable. Do not add secrets.

AWS_REGION=us-east-1
SSM_PARAMETER_PATH=/waypoint/prod
ECR_REPO=985096928297.dkr.ecr.us-east-1.amazonaws.com/waypoint-api
WAYPOINT_API_HOST=203-0-113-10.sslip.io
